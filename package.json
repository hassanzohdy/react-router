{
  "name": "@mongez/react-router",
  "version": "2.8.2",
  "description": "A configuration-based React router with lazy-loaded apps/modules, locale-aware routing, middleware, prefetch-on-hover, and production-ready chunk error handling.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./navigation": {
      "types": "./src/navigation.ts",
      "import": "./src/navigation.ts",
      "default": "./src/navigation.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mongez/concat-route": "^1.1.0",
    "@mongez/events": "^2.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hassanzohdy/react-router"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "mongez",
    "react",
    "router",
    "react-router",
    "routing",
    "lazy-loading",
    "code-splitting",
    "middleware",
    "i18n",
    "localization",
    "prefetch",
    "chunk-error",
    "dom"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0"
}
